# ===== SAFEMARKET API - ENVIRONMENT TEMPLATE =====
# Copy this file to .env and customize values for your environment

# === ENVIRONMENT ===
ENVIRONMENT=development

# === SECURITY ===
# IMPORTANTE: Cambiar SECRET_KEY en producción (mínimo 32 caracteres)
SECRET_KEY=safemarket-secret-key-2026-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=2

# === DATABASE ===
# Option 1: PostgreSQL (RECOMMENDED for production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/safemarket

# Option 2: SQLite (only for development)
# DATABASE_URL=sqlite:///./safemarket.db

# === CORS ===
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# === LOGGING ===
LOG_LEVEL=DEBUG

# === COOKIES ===
COOKIE_SECURE=False          # Set to True in production with HTTPS
COOKIE_HTTPONLY=True         # Keep True for security
COOKIE_SAMESITE=lax          # Options: lax, strict, none

# === RATE LIMITING ===
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=60

